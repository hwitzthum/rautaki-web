# n8n Chat Widget — public webhook URL for the support chatbot
NEXT_PUBLIC_N8N_CHAT_WEBHOOK_URL=https://your-n8n-instance.com/webhook/chat

# Resend — API key for transactional email (lab-access registration notifications)
RESEND_API_KEY=re_your_api_key_here

# Upstash Redis — persistent rate limit for /api/lab-access. Without these the
# route falls back to a per-instance in-memory limiter (logs a warning in prod
# and is trivially bypassable across serverless cold starts). Provision via
# the Vercel Upstash integration.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Sentry — DSN for error reporting (public; safe to expose in browser bundle)
NEXT_PUBLIC_SENTRY_DSN=https://your_key@oYOUR_ORG.ingest.de.sentry.io/YOUR_PROJECT

# Sentry — auth token for source map uploads (set by Sentry wizard)
SENTRY_AUTH_TOKEN=sntrys_your_token_here
