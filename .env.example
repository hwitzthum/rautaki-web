# n8n Chat — SERVER-SIDE webhook URL.
# The browser talks to /api/chat (a Next.js route) which forwards here.
# Do NOT add NEXT_PUBLIC_ to this name — keep the URL off the client bundle.
N8N_CHAT_WEBHOOK_URL=https://your-n8n-instance.com/webhook/<uuid>/chat

# HMAC shared secret used by /api/chat to sign requests to n8n. The n8n
# workflow MUST verify the signature before doing any work — see
# security/n8n-workflow-hardening.md. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_CHAT_SHARED_SECRET=replace-me-with-64-hex-chars

# Salt used to pseudonymise client IPs in Sentry logs via HMAC-SHA256.
# Must be set in production — if unset, a dev-only fallback is used.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=

# Optional: per-IP chat rate-limit max per 5-minute sliding window.
# Default 30 if unset.
# CHAT_RATE_MAX=30

# Resend — API key for transactional email (lab-access registration notifications)
RESEND_API_KEY=re_your_api_key_here

# Optional: n8n webhook URL that forwards Lab gate signups to Salesflare CRM
# (tagged "Lab"). Best-effort / non-blocking — if unset, the CRM forward step
# is skipped entirely and Lab access still works. Must be an https:// URL that
# does not resolve to a private/internal address — see src/lib/ssrf-guard.ts.
N8N_LAB_WEBHOOK_URL=

# Upstash Redis — persistent rate limit for /api/lab-access AND /api/chat.
# Without these both routes fall back to a per-instance in-memory limiter
# (logs a warning in prod and is trivially bypassable across serverless
# cold starts). Provision via the Vercel Upstash integration.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Sentry — DSN for error reporting (public; safe to expose in browser bundle)
NEXT_PUBLIC_SENTRY_DSN=https://your_key@oYOUR_ORG.ingest.de.sentry.io/YOUR_PROJECT

# Sentry — auth token for source map uploads (set by Sentry wizard)
SENTRY_AUTH_TOKEN=sntrys_your_token_here

# ── Maintenance mode ──────────────────────────────────────────────────────
# Set to "true" to serve the /maintenance holding page for all traffic
# (see src/proxy.ts). API routes return 503 JSON; /api/cron/* stays open.
# MAINTENANCE_MODE=false

# Vercel Cron auth — shared secret checked by /api/cron/keepalive.
# Vercel sends it automatically as "Authorization: Bearer <CRON_SECRET>"
# when the env var is set on the project.
CRON_SECRET=

# ── Signed action links (Mahnwesen / Referral / Unsubscribe) ──────────────
# HMAC secrets for the signed links embedded in outbound emails. Each flow
# fails closed: with the secret unset, every link verification returns
# "Link ungültig" (400). Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAHNUNG_SECRET=
REFERRAL_SECRET=
UNSUBSCRIBE_SECRET=

# Bearer token n8n must present to the send/request routes
# (briefing-send, digest-send, nurture-send, mahnung-request, referral-request).
N8N_SEND_TOKEN=

# Optional: n8n webhook that receives Mahnung status updates from
# /api/mahnung-action. Same SSRF rules as the other webhook URLs.
N8N_MAHNUNG_STATUS_WEBHOOK_URL=

# ── Chat limits (optional, defaults in src/app/api/chat/route.ts) ─────────
# Per-session sliding-window max and global daily token budget.
# CHAT_SESSION_RATE_MAX=
# CHAT_DAILY_TOKEN_CAP=

# ── DeepL (local translation script only — NEVER set on Vercel) ───────────
# Used by `npm run translate` (scripts/translate-content.ts) to generate
# src/content/en/* from the German content modules. Free-tier keys end in :fx.
DEEPL_API_KEY=
