# n8n Chat Widget — public webhook URL for the support chatbot
NEXT_PUBLIC_N8N_CHAT_WEBHOOK_URL=https://your-n8n-instance.com/webhook/chat

# n8n Booking Webhook — server-side webhook for booking form submissions
N8N_BOOKING_WEBHOOK_URL=https://your-n8n-instance.com/webhook/booking

# Sentry — DSN for error tracking (server/edge runtime)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Sentry — DSN for client-side error tracking (exposed in browser bundle)
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Sentry — auth token for source map uploads (set by Sentry wizard)
SENTRY_AUTH_TOKEN=sntrys_your_token_here
