# n8n Chat — SERVER-SIDE webhook URL.
# The browser talks to /api/chat (a Next.js route) which forwards here.
# Do NOT add NEXT_PUBLIC_ to this name — keep the URL off the client bundle.
N8N_CHAT_WEBHOOK_URL=https://your-n8n-instance.com/webhook/<uuid>/chat

# HMAC shared secret used by /api/chat to sign requests to n8n. The n8n
# workflow MUST verify the signature before doing any work — see
# security/n8n-workflow-hardening.md. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_CHAT_SHARED_SECRET=replace-me-with-64-hex-chars

# Salt used to pseudonymise client IPs in Sentry logs via HMAC-SHA256.
# Must be set in production — if unset, a dev-only fallback is used.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=

# Optional: per-IP chat rate-limit max per 5-minute sliding window.
# Default 30 if unset.
# CHAT_RATE_MAX=30

# Resend — API key for transactional email (lab-access registration notifications)
RESEND_API_KEY=re_your_api_key_here

# Upstash Redis — persistent rate limit for /api/lab-access AND /api/chat.
# Without these both routes fall back to a per-instance in-memory limiter
# (logs a warning in prod and is trivially bypassable across serverless
# cold starts). Provision via the Vercel Upstash integration.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Sentry — DSN for error reporting (public; safe to expose in browser bundle)
NEXT_PUBLIC_SENTRY_DSN=https://your_key@oYOUR_ORG.ingest.de.sentry.io/YOUR_PROJECT

# Sentry — auth token for source map uploads (set by Sentry wizard)
SENTRY_AUTH_TOKEN=sntrys_your_token_here
